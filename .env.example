# Copy to .env and adjust values for local Docker development.
# Do NOT commit .env with real secrets.

# PostgreSQL (Docker service name: postgres)
POSTGRES_USER=draw
POSTGRES_PASSWORD=drawpassword
POSTGRES_DB=drawapp
DATABASE_URL=postgresql://draw:drawpassword@postgres:5432/drawapp

# Redis (Docker service name: redis)
REDIS_URL=redis://redis:6379

# Auth
JWT_SECRET=dev-jwt-secret-change-me

# HTTP backend
PORT=3002
FRONTEND_URL=http://localhost:3000
OAUTH_CALLBACK_BASE_URL=http://localhost:3002

# OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend (browser-facing URLs — NOT Docker internal hostnames)
NEXT_PUBLIC_HTTP_BACKEND=http://localhost:3002
NEXT_PUBLIC_WS_URL=ws://localhost:8080
